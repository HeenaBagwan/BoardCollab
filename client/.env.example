# ==============================================================================
# BoardCollab - Client Environment Configuration (Vite)
# ==============================================================================

# Backend REST API URL (Render Web Service URL)
# In production on Vercel: set to your deployed Render service URL (with or without /api)
# Example: https://boardcollab-server.onrender.com/api
# In local development: leave empty to use Vite's local proxy (/api -> http://localhost:5000)
VITE_API_URL=http://localhost:5000/api

# Real-Time Socket.IO Server URL (Render Web Service URL)
# In production on Vercel: set to your deployed Render service URL
# Example: https://boardcollab-server.onrender.com
# In local development: leave empty to use Vite's local websocket proxy
VITE_SOCKET_URL=http://localhost:5000
