# ==============================================================================
# BoardCollab - Server Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Frontend Client URL (strictly allowed by CORS and used for cross-site cookies)
# Production example: https://your-boardcollab-client.vercel.app
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration (Aiven Cloud or Local)
# On Aiven: Service URI format is mysql://avnadmin:password@host:port/defaultdb?ssl-mode=REQUIRED
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=boardcollab

# SSL Configuration (REQUIRED for Aiven MySQL)
# Set to 'true' or 'require' on Render/Aiven; omit or set to 'false' for local MySQL without SSL
DB_SSL=false
# Set to false to accept Aiven's managed CA certificate without manual CA file uploading
DB_SSL_REJECT_UNAUTHORIZED=false
DB_CONNECTION_LIMIT=15

# Optional Redis Adapter (For multi-instance horizontal scaling)
# Leave unset or empty to use the default in-memory adapter (Free Tier / single instance)
# REDIS_URL=rediss://default:your_redis_password@your-redis-host:6379

# JWT Authentication Secrets (Generate 64+ char random strings for production)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin Access Control (comma-separated email list allowed to access /admin dashboard)
ADMIN_EMAILS=admin@boardcollab.com
