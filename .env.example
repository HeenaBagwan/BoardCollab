# ==============================================================================
# BoardCollab - Monorepo Root Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (allowed by server CORS)
CLIENT_URL=http://localhost:5173

# MySQL Database (Local or Cloud like Aiven)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=boardcollab
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Optional Redis Adapter (omit for single-instance in-memory setup)
# REDIS_URL=redis://127.0.0.1:6379

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin Dashboard Access
ADMIN_EMAILS=admin@boardcollab.com

# Client Vite Configuration (when running client independently)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
